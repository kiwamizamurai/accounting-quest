{
  "name": "accounting-game",
  "version": "1.0.0",
  "description": "A visual novel-style educational game that teaches double-entry bookkeeping through running a lemonade stand",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "keywords": [
    "accounting",
    "bookkeeping",
    "double-entry-bookkeeping",
    "education",
    "educational-game",
    "game",
    "visual-novel",
    "lemonade",
    "phaser",
    "typescript"
  ],
  "author": "kiwamizamurai (https://github.com/kiwamizamurai)",
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.2.1",
    "@vitest/ui": "^4.0.18",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "homepage": "https://kiwamizamurai.github.io/accounting-quest/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwamizamurai/accounting-quest.git"
  },
  "bugs": {
    "url": "https://github.com/kiwamizamurai/accounting-quest/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true
}
